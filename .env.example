# Copia este fichero a .env y ajusta los valores. Nunca subas .env al repositorio.
DATABASE_URL=postgresql+psycopg://vault:vault@localhost:5432/vault
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRE_MINUTES=60
STORAGE_DIR=./storage
# Opcional: necesaria solo para el endpoint de resumen con IA
ANTHROPIC_API_KEY=
